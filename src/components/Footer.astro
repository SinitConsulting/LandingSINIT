---
import { siteInfo } from '../data/content';
const currentYear = new Date().getFullYear();
---

<footer class="text-[#F8FAFC] pt-16 pb-8 border-t border-[#00C9FF]/20 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      
      <div class="md:col-span-2">
        <a href="/" aria-label="Inicio" class="inline-block mb-6">
          <span class="text-2xl font-bold tracking-tighter">SINIT <span class="text-[#00C9FF]">Consulting</span></span>
        </a>
        <p class="text-[#94A3B8] mb-6 max-w-sm">
          {siteInfo.description}
        </p>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-[#00C9FF]">Contacto</h4>
        <ul class="space-y-3 text-sm text-[#94A3B8]">
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00C9FF]"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            +{siteInfo.whatsappNumber}
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00C9FF]"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            {siteInfo.email}
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00C9FF]"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {siteInfo.location}
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-[#00C9FF]">Navegación</h4>
        <ul class="space-y-2 text-sm text-[#94A3B8]">
          <li><a href="#problema" class="hover:text-[#00C9FF] transition-colors">El Problema</a></li>
          <li><a href="#servicios" class="hover:text-[#00C9FF] transition-colors">Servicios</a></li>
          <li><a href="#proceso" class="hover:text-[#00C9FF] transition-colors">Cómo Trabajamos</a></li>
        </ul>
      </div>
      
    </div>

    <div class="pt-8 border-t border-[#334155] flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-[#94A3B8]/70">
      <p>&copy; {currentYear} {siteInfo.name}. Todos los derechos reservados.</p>
      <p class="max-w-xl text-center md:text-right">
        {siteInfo.privacyNote}
      </p>
    </div>
  </div>
</footer>
