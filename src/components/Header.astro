---
import { siteInfo } from '../data/content';
---

<header class="fixed w-full top-0 z-50 bg-[#0F172A]/90 backdrop-blur-md border-b border-[#334155]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="flex-shrink-0 flex items-center">
        <!-- Reemplazar src con SINIT logo2026.png -->
        <a href="/" aria-label="Inicio" class="flex items-center">
          <img src="/SINITlogo2026.png" alt="SINIT Consulting" class="h-10 w-auto" />
        </a>
      </div>
      
      <nav class="hidden md:flex space-x-8">
        <a href="#problema" class="text-[#F8FAFC] hover:text-[#00C9FF] font-medium transition-colors">El Problema</a>
        <a href="#servicios" class="text-[#F8FAFC] hover:text-[#00C9FF] font-medium transition-colors">Servicios</a>
        <a href="#proceso" class="text-[#F8FAFC] hover:text-[#00C9FF] font-medium transition-colors">Cómo Trabajamos</a>
      </nav>

      <div class="flex items-center">
        <a 
          href={`https://wa.me/${siteInfo.whatsappNumber}?text=${encodeURIComponent(siteInfo.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center justify-center px-4 py-2 bg-[#2ac4b0] hover:bg-[#22a392] text-[#0F172A] font-bold rounded-lg transition-colors"
        >
          Agenda tu diagnóstico gratis
        </a>
      </div>
    </div>
  </div>
</header>
